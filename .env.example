# Copy to .env.development.local for local development. Never commit real values.
# Admin password for /admin (at least 12 characters).
ADMIN_PASSWORD=
# Random value of at least 32 characters used to sign admin session cookies.
ADMIN_SESSION_SECRET=
# Vercel Blob read-write token for the private rates store (from `npx vercel env pull .env.local`).
BLOB_READ_WRITE_TOKEN=
# Email through Resend (optional; without these no email is sent).
# A "Full access" API key from resend.com > API Keys.
RESEND_API_KEY=
# Sender, e.g. Acme Investments <inquiries@mail.acme.com>. Before a domain is verified,
# use onboarding@resend.dev (Resend then only delivers to the account owner's address).
EMAIL_FROM=
# Domain that receives customer replies, e.g. reply.acme.com or your <id>.resend.app address domain.
EMAIL_REPLY_DOMAIN=
# Signing secret (whsec_...) of the Resend webhook that posts to /api/email/inbound.
RESEND_WEBHOOK_SECRET=
