# Copy to .env.development.local (or .env.local) for local development. Never commit real values.
# The same names are set in each hosting provider (Vercel, Netlify, Cloudflare); see docs/MULTI_PROVIDER.md.

# ---------------------------------------------------------------- Admin sign-in
# Admin password for /admin (at least 12 characters).
ADMIN_PASSWORD=
# Random value of at least 32 characters used to sign admin session cookies.
# It also encrypts the two-step sign-in secrets: changing it means everyone with
# two-step sign-in must use a recovery code and set it up again.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------- Supabase (shared by every provider)
# Project URL, Supabase dashboard > Project Settings > API, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Secret / service_role key (same page). SERVER ONLY: never prefix it with NEXT_PUBLIC_, never put it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the publishable (anon) key. Public by design; only sent along with direct file uploads.
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- Which data set and provider
# "production" on whichever provider serves the live site; leave empty for local development
# (an empty "local" data set). On Vercel this can stay empty: Vercel's own VERCEL_ENV is used.
APP_ENV=
# vercel | netlify | cloudflare (shown by /api/health; detected automatically on Vercel and Netlify).
DEPLOY_PROVIDER=
# Set to false on a provider you are NOT using right now: its scheduled jobs then do nothing.
PROVIDER_ACTIVE=true
# The live site's address, e.g. https://payouts.example.com. Used for links in emails (all providers).
SITE_URL=

# ---------------------------------------------------------------- Scheduled jobs
# Payout reminders and trading snapshots: the scheduler of the active provider calls
# /api/cron/* with "Authorization: Bearer <CRON_SECRET>". Any random value of at least 16 characters.
# Without it the jobs are refused.
CRON_SECRET=

# ---------------------------------------------------------------- Email (optional)
# Without a provider no email is sent. See README > Email. gmail now, resend later.
EMAIL_PROVIDER=
# Optional name customers see, e.g. Acme Investments.
EMAIL_SENDER_NAME=
# Gmail: the account address and an app password (needs 2-Step Verification).
# Note: Gmail uses SMTP/IMAP connections, which work on Vercel and Netlify but NOT on Cloudflare
# Workers. Use EMAIL_PROVIDER=resend there.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend: a "Full access" API key, the sender on a verified domain, the reply domain
# and the signing secret (whsec_...) of the webhook that posts to /api/email/inbound.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Trading dashboard (optional)
# Master Admin, Settings > Trading dashboard: read-only figures from a separate app on your own
# machine, over its data API. See README > Trading dashboard.
TRADING_API_URL=
TRADING_API_TOKEN=

# ---------------------------------------------------------------- Only for the one-time migration
# Needed only by `npm run migrate:vercel-to-supabase` (npx vercel env pull .env.local). Not used by the app.
BLOB_READ_WRITE_TOKEN=
