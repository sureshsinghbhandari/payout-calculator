# Copy to .env.development.local for local development. Never commit real values.
# Admin password for /admin (at least 12 characters).
ADMIN_PASSWORD=
# Random value of at least 32 characters used to sign admin session cookies.
ADMIN_SESSION_SECRET=
# Vercel Blob read-write token for the private rates store (from `npx vercel env pull .env.local`).
BLOB_READ_WRITE_TOKEN=
# Email (optional; without a provider no email is sent). See README > Email.
# gmail now, resend later (once there is a company domain).
EMAIL_PROVIDER=
# Optional name customers see, e.g. Acme Investments.
EMAIL_SENDER_NAME=
# Gmail: the account address and an app password (needs 2-Step Verification).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend: a "Full access" API key, the sender on a verified domain, the reply domain
# and the signing secret (whsec_...) of the webhook that posts to /api/email/inbound.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=
# Payout reminders: Vercel Cron calls /api/cron/payout-notices daily with this secret
# (Authorization: Bearer ...). Any random value of at least 16 characters. Without it the job is refused.
CRON_SECRET=
